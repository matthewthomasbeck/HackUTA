[Unit]
Description=Calypso LiveKit media transport
Wants=network-online.target
After=network-online.target calypso-backend.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/HackUTA/agent
EnvironmentFile=/etc/calypso/media.env
ExecStart=/root/HackUTA/agent/.venv/bin/python -m calypso_agent.main start
Restart=always
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
