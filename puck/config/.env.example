# Copy to config/.env (git-ignored). systemd EnvironmentFile= can point here.

# Backend receiving socket
BACKEND_IP=192.168.1.10
BACKEND_PORT=8000

# Mic ALSA device / bus (from Spike D: arecord -l)
MIC_DEVICE=plughw:1,0

# Pipeline
CHUNK_MS=30
CONNECT_RETRY_SEC=5
CONNECTION_CHECK_SEC=2

# NCS2 + local models (fill when offline path is real)
NCS2_DEVICE=
STT_MODEL_PATH=
VOICE_MODEL_PATH=
