# Copy to config/.env (git-ignored).

# Vishnu's FastAPI host (HTTP — POST /puck/segments)
BACKEND_IP=127.0.0.1
BACKEND_PORT=8000
# Must match backend CALYPSO_API_TOKEN
API_TOKEN=change-me

# ALSA device from Spike D (arecord -l), or "sine" for a laptop test tone
MIC_DEVICE=sine

# Mic frame size (ms) and how much audio to buffer before each upload
CHUNK_MS=30
SEGMENT_MS=3000

CONNECT_RETRY_SEC=5
CONNECTION_CHECK_SEC=2

# Offline / NCS2 (ignored by online path for now)
NCS2_DEVICE=
STT_MODEL_PATH=
VOICE_MODEL_PATH=
