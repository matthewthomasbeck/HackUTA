# Copy to config/.env (git-ignored).

# Vishnu's FastAPI host (HTTP — POST /puck/segments)
BACKEND_IP=127.0.0.1
BACKEND_PORT=8000
# Must match backend CALYPSO_API_TOKEN
API_TOKEN=change-me

# ALSA device from Spike D (arecord -l), or "sine" for a laptop test tone
MIC_DEVICE=sine

# Run path: online (health + listener) | offline (force emergency ID path)
MODE=offline

# Mic frame size (ms) — same in online and offline
CHUNK_MS=30
# Online: how much audio to buffer before each POST /puck/segments
SEGMENT_MS=3000
# Offline: concat CHUNK_MS frames to this length before voice-fingerprint infer
# (separate from SEGMENT_MS so reconnect does not change upload behavior)
OFFLINE_SEGMENT_MS=3000

CONNECT_RETRY_SEC=5
CONNECTION_CHECK_SEC=2

# Offline inference: cpu (MVP). coral|ncs2 reserved.
INFER_BACKEND=cpu
CORAL_DEVICE=
NCS2_DEVICE=
STT_MODEL_PATH=

# Titanet-small (192-d) via sherpa-onnx — run scripts/setup_voice_id.sh
VOICE_MODEL_PATH=models/nemo_en_titanet_small.onnx
GALLERY_DIR=gallery
VOICE_MATCH_THRESHOLD=0.45
# Skip quiet / silence windows (mean |sample|); raise if room is noisy
MIN_SPEECH_RMS=0.02

# Bluetooth → iPhone: puck writes WHO JSON here; run scripts/ble_who_peripheral.py
BT_ADAPTER=hci0
BT_PEER_NAME=
WHO_DROP_PATH=/tmp/calypso_who.json
