[Unit]
Description=Calypso⁻¹ puck (mic → backend / offline models)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# Adjust paths for the Pi user / clone location.
WorkingDirectory=%h/Projects/HackUTA/puck
EnvironmentFile=-%h/Projects/HackUTA/puck/config/.env
ExecStart=%h/Projects/HackUTA/puck/build/calypso_puck
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
