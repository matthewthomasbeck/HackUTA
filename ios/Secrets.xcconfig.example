// Copy to Secrets.xcconfig (git-ignored) and fill in. Optional: the app builds without it.
// Use https, or a raw IP for local dev: ATS blocks plain-http hostnames.
// In xcconfig, "//" starts a comment, so write URLs as https:/$()/host to keep the slashes.
API_BASE_URL = http:/$()/192.168.1.10:8000
API_TOKEN = replace-me
CHERT_PHONE = +15551234567

// Device builds: your Apple team ID (Xcode → Settings → Accounts → team, or developer.apple.com → Membership).
// A free Personal Team works, but its bundle ID must be unique, so change APP_BUNDLE_ID too.
DEVELOPMENT_TEAM = ABCDE12345
APP_BUNDLE_ID = com.yourname.calypso
