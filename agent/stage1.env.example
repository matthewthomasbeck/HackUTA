# Copy/merge into agent/.env.local; never commit populated credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
XAI_API_KEY=
CALYPSO_BACKEND_URL=http://64.177.56.85:8000
CALYPSO_API_TOKEN=
AGENT_NAME=calypso-stage1
CALYPSO_STAGE1=true
# Explicit modes: setup for a relative, group for recognition test.
CALYPSO_CALL_MODE=setup
# Controlled recognition: identified | learning | uncertain.
STAGE1_RECOGNITION=learning
STAGE1_STATE_FILE=data/stage1-enrollment.json
# Optional exact LiveKit participant identity. Blank selects the first caller.
STAGE1_PARTICIPANT_ID=
# Claude key/model belong in the backend's Vultr environment, not this file.
