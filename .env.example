# Copy to .env and fill in. Never commit .env.

# Backend (Vishnu)
CALYPSO_API_TOKEN=change-me
ANTHROPIC_API_KEY=
CALYPSO_AGENT_MODEL=claude-sonnet-4-6
XAI_API_KEY=
CALYPSO_STT=grok          # grok | fake (defaults to grok when XAI_API_KEY is set)
CALYPSO_TTS=grok          # grok | fake
# Passive recall. Each defaults to the real provider when its key is set, else fake.
CALYPSO_SUMMARIZER=claude         # claude | fake
CALYPSO_DETECTOR=claude           # claude | fake
CALYPSO_SUMMARY_MODEL=claude-sonnet-4-6
CALYPSO_DETECTOR_MODEL=claude-haiku-4-5
CALYPSO_HOME_LABEL=Home
CALYPSO_DB=data/calypso.db
# Face/voice prints (open-source models; fetch with: cd backend && uv run python scripts/fetch_models.py)
# opencv = YuNet + SFace | fake (tests)
CALYPSO_FACE=opencv
# sherpa = NeMo TitaNet-small via sherpa-onnx | fake (tests)
CALYPSO_VOICE=sherpa
CALYPSO_MODELS_DIR=data/models
# Provisional thresholds; tune from the `recognize` events on real calls.
FACE_MATCH=0.40
FACE_MARGIN=0.08
VOICE_MATCH=0.50
VOICE_MARGIN=0.08
# Patient's time zone: days are split at local midnight here.
CALYPSO_TZ=America/Chicago
# Must equal the iOS API_BASE_URL. https:// when deployed (iOS won't load http:// images).
CALYPSO_PUBLIC_URL=https://your-vultr-host
# inline (laptop/tests, no Redis) | rq (Vultr: Keanu's Redis + `rq worker recordings`)
CALYPSO_JOBS=inline
CALYPSO_REDIS_URL=redis://127.0.0.1:6379/0
# Where the RQ worker posts dashboard events (the API itself, on the same box).
CALYPSO_BACKEND_URL=http://127.0.0.1:8000
# local (data/files/) | s3 (Vultr Object Storage). Only face crops and photos; audio is never stored.
CALYPSO_STORAGE=local
S3_ENDPOINT_URL=https://atl2.vultrobjects.com
ENROLLMENT_BUCKET=
# S3 keys: set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here, or AWS_PROFILE=memory-bank on Vultr.
AWS_PROFILE=

# Puck (Matt)
CALYPSO_BASE_URL=https://your-vultr-host
PUCK_MIC=
PUCK_SOUND_BACKEND=cpu    # cpu | coral | hailo | fake
PUCK_SOUND_EVERY_N=1
PUCK_SPOOL_DIR=/var/lib/calypso-puck/spool   # systemd StateDirectory= creates it; use ./spool for manual runs
PUCK_SPOOL_MAX_MB=512

# Agent (Keanu)
CHERT_API_KEY=
CHERT_PROJECT_ID=
# Track spike: short-lived token for an observer identity in the same call room.
LIVEKIT_URL=
LIVEKIT_TOKEN=
AGENT_TRACK_MODE=per_participant        # per_participant | composite
GROUP_CALL_START=manual_only            # agent_dials_both | agent_dials_relative_then_add | manual_only
