# Copy to .env and fill in. Never commit .env.

# Backend (Vishnu)
CALYPSO_API_TOKEN=change-me
ANTHROPIC_API_KEY=
XAI_API_KEY=
CALYPSO_STT=grok          # grok | whisper | fake
CALYPSO_TTS=grok          # grok | fake
CALYPSO_DB=data/calypso.db

# Puck (Matt)
CALYPSO_BASE_URL=https://your-vultr-host
PUCK_MIC=
PUCK_SOUND_BACKEND=cpu    # cpu | coral | hailo | fake
PUCK_SOUND_EVERY_N=1

# Agent (Keanu)
CHERT_API_KEY=
CHERT_PROJECT_ID=
AGENT_TRACK_MODE=per_participant        # per_participant | composite
GROUP_CALL_START=manual_only            # agent_dials_both | agent_dials_relative_then_add | manual_only
